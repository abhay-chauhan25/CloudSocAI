# Copy to .env and set your own values. .env is gitignored; never commit it.
# Used by both docker-compose.yml and the backend.

POSTGRES_USER=cloudsoc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cloudsoc
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# AI analyst (optional). With a key, incident analyses are generated by Gemini;
# without one, an offline mock is used. Set AI_PROVIDER=mock|gemini|disabled to choose.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# AI_PROVIDER=
