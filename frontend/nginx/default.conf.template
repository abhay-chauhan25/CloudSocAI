# Serves the built dashboard and forwards /api/... to the backend, exactly
# like the Vite dev server does, so the browser only ever talks to one
# origin and the API needs no CORS.
#
# A template: at start-up the nginx image replaces ${API_KEY} from the
# container's environment and writes the result to /etc/nginx/conf.d/.
# nginx's own variables ($host, $uri, ...) are left alone.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Do not advertise the nginx version in headers or error pages.
    server_tokens off;

    location /api/ {
        # "api" is the backend's service name on the Compose network.
        proxy_pass http://api:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The key is added here, server-side, so the browser never sees it.
        # A key sent by the browser itself is overwritten.
        proxy_set_header X-API-Key "${API_KEY}";
        # The AI analysis call can take up to the provider timeout (45 s).
        proxy_read_timeout 60s;
    }

    # Built assets have content hashes in their names, so they can be cached forever.
    # (add_header in a location replaces the server's headers, hence the include.)
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Client-side routes (/incidents/..., /findings/...) all load index.html.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
